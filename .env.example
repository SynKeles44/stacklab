# Stacklab – lokale Konfiguration
# Kopiere diese Datei nach .env, wenn du etwas ändern willst. Ohne .env gelten die Standardwerte.

# Port, unter dem Stacklab im Browser erreichbar ist: http://localhost:8080
STACKLAB_PORT=8080

# Nur dein Rechner erreicht Stacklab. 0.0.0.0 macht es im ganzen Netzwerk erreichbar (z. B. fürs Handy) –
# dann kann jeder im WLAN ein Konto anlegen, das Übungs-Terminal nutzen und deine Ordnernamen sehen.
STACKLAB_BIND=127.0.0.1

# Dein Übungsordner auf dem Rechner. Pro Kurs entsteht darin ein Unterordner (git/, npm/, laravel/ …).
# Relativ zum Projektordner oder absolut, z. B. /Users/du/stacklab-workspace oder C:/Users/du/stacklab-workspace
STACKLAB_WORKSPACE=./workspace

# Nur Linux: Benutzer-ID und Gruppen-ID, mit denen das Übungs-Terminal Dateien anlegt.
# Ermitteln mit: id -u  und  id -g   (macOS und Windows: nicht ändern)
STACKLAB_UID=1000
STACKLAB_GID=1000

# Ressourcen-Grenzen des Übungs-Terminals
STACKLAB_SANDBOX_MEMORY=2g
STACKLAB_SANDBOX_CPUS=2

# Passwort der lokalen Datenbank (nur im Docker-Netz erreichbar)
STACKLAB_DB_PASSWORD=stacklab
